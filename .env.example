# Copy to .env (`make env` does this and generates random local-dev passwords). Never commit .env.
# Prefer the Keychain for API keys (scripts/with-secrets.sh).

# --- PostgreSQL (docker-compose reads these too) ---
POSTGRES_USER=signal_scout
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
# Host port for the compose Postgres; 5433 avoids clashing with a locally installed Postgres on 5432.
POSTGRES_PORT=5433
POSTGRES_DB=signal_scout
# Optional full override, e.g. postgresql+asyncpg://user:pass@host:5432/db (CI, managed databases).
DATABASE_URL=

# --- S3 / MinIO (the MinIO root credentials are these keys in local dev) ---
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=signal-scout
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=signal-scout
S3_SECRET_ACCESS_KEY=

# --- Elasticsearch (user "elastic") ---
ELASTICSEARCH_URL=http://localhost:9200
ELASTIC_PASSWORD=

# --- LLM provider: gemini (default, free tier) or claude ---
LLM_PROVIDER=gemini
# Optional model override; defaults: gemini-3.5-flash-lite / claude-haiku-5-5.
LLM_MODEL=
# Optional client-side pacing (default for gemini-3.5-flash-lite: 12/min, 450/day; free tier is 15/min, 500/day).
LLM_RPM=
LLM_RPD=

# CostGuard caps on PAID spend (USD). Gemini free tier counts as $0.
COST_DAILY_CAP_USD=0.50
COST_TOTAL_CAP_USD=4.50

# --- REST API and MCP server (`make env` generates local random values for the two secrets) ---
# X-API-Key required on write endpoints (POST/DELETE /api/v1/webhooks). Empty disables writes.
API_KEY=
# HMAC secret external tools sign POST /api/v1/ingest/webhook with. Empty disables the endpoint.
INBOUND_WEBHOOK_SECRET=
API_HOST=127.0.0.1
API_PORT=8000
MCP_HOST=127.0.0.1
MCP_PORT=8001

# --- Ingestion (defaults are fine) ---
# HTTP_RATE_PER_DOMAIN=0.5
# CIRCUIT_BREAKER_THRESHOLD=5
LOG_LEVEL=INFO

# --- Secrets (leave empty here if you use the Keychain wrapper) ---
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
SLACK_WEBHOOK_URL=
