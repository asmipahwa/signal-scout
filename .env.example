# Copy to .env for non-secret settings. Prefer the Keychain for API keys (scripts/with-secrets.sh).
# Never commit .env.

# LLM provider: gemini (default, free tier) or claude.
LLM_PROVIDER=gemini
# Optional model override; defaults: gemini-3.5-flash-lite / claude-haiku-5-5.
LLM_MODEL=
# Optional client-side pacing (default for gemini-3.5-flash-lite: 12/min, 450/day; free tier is 15/min, 500/day).
LLM_RPM=
LLM_RPD=

# CostGuard caps on PAID spend (USD). Gemini free tier counts as $0.
COST_DAILY_CAP_USD=0.50
COST_TOTAL_CAP_USD=4.50

# Secrets (leave empty here if you use the Keychain wrapper).
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
SLACK_WEBHOOK_URL=
